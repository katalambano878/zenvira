# Sika Homes — plain Postgres (no Supabase)
# Copy to .env.local and fill in real values before deploy.

# App / branding
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WORDMARK=Sika Homes
NEXT_PUBLIC_SITE_NAME=Sika Homes
NEXT_PUBLIC_SITE_TAGLINE=Furniture, sofas & interiors for beautiful homes in Ghana.
NEXT_PUBLIC_CONTACT_EMAIL=hello@sikahomes.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_TEL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=Ghana
NEXT_PUBLIC_SMS_SENDER_ID=SIKAHOMES
NEXT_PUBLIC_SKU_PREFIX=SIKA
NODE_ENV=development

# Database (VPS Postgres / local)
DATABASE_URL=postgresql://sikahomes:CHANGE_ME@127.0.0.1:5432/sikahomes

# Auth (generate with: openssl rand -base64 48)
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
AUTH_COOKIE_NAME=sikahomes_session
AUTH_COOKIE_MAX_AGE_DAYS=7

# Uploads on disk (served at /uploads/*)
UPLOAD_DIR=./uploads
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:3001/uploads

# Email / SMS / payments — leave empty until configured
ADMIN_EMAIL=
MOOLRE_MERCHANT_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
# Required in staging/production — cron refuses requests without Bearer token
CRON_SECRET=CHANGE_ME_CRON_SECRET

MOOLRE_ACCOUNT_NUMBER=
MOOLRE_API_PUBKEY=
MOOLRE_API_USER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_API_KEY=
MOOLRE_API_KEY=
MOOLRE_SMS_SENDER_ID=

# Optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
ADMIN_SMS_NUMBERS=
